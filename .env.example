# Teams Notification API Server Environment Variables
# Copy this file to .env and fill in your actual values

# =============================================================================
# REQUIRED: Teams Bot Configuration
# Get these from your Microsoft Bot Framework registration
# =============================================================================
TEAMS_APP_ID=your-bot-app-id-here
TEAMS_APP_SECRET=your-bot-app-secret-here
TEAMS_BOT_ID=28:your-bot-app-id-here

# =============================================================================
# REQUIRED: Authentication Secret
# Generate a strong random string for JWT signing
# =============================================================================
JWT_SECRET=your-super-secret-jwt-signing-key-here

# =============================================================================
# OPTIONAL: Override Default Settings
# =============================================================================

# Server Configuration
# SERVER_PORT=8080
# SERVER_ENVIRONMENT=development

# Database Configuration (defaults work with docker-compose)
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_USERNAME=teams_notify
# DATABASE_PASSWORD=teams_notify_password
# DATABASE_NAME=teams_notify

# Redis Configuration (defaults work with docker-compose)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=redis_password

# Logging Configuration
# LOGGING_LEVEL=info
# LOGGING_FORMAT=json

# =============================================================================
# How to generate secure secrets:
# =============================================================================
# JWT_SECRET: openssl rand -base64 64
# Or online: https://generate-random.org/api-key-generator (64+ characters)